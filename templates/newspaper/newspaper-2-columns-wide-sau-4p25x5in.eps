%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 306 360
%%HiResBoundingBox: 0 0 306 360
%%Title: Newspaper 2 Columns wide (SAU) (4.25x5 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 18 18 270 324 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 0 0 306 360 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 153 360 moveto 153 0 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 0 180 moveto 306 180 lineto stroke
grestore
showpage
%%EOF
