%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 621 720
%%HiResBoundingBox: 0 0 621 720
%%Title: Newspaper 4 Columns wide (SAU) (8.625x10 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 18 18 585 684 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 0 0 621 720 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 310.5 720 moveto 310.5 0 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 0 360 moveto 621 360 lineto stroke
grestore
showpage
%%EOF
