%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 640 100
%%HiResBoundingBox: 0 0 640 100
%%Title: TikTok Ads 640x100
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Red Green Blue
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
1 setlinewidth
% layer: Safe Zone
0.118 0.667 0.314 setrgbcolor
[] 0 setdash 5 5 630 90 rectstroke
% layer: Trim
0.000 0.588 0.863 setrgbcolor
[] 0 setdash 0 0 640 100 rectstroke
% layer: Guides
0.627 0.353 0.863 setrgbcolor
[6 4] 0 setdash newpath 320 100 moveto 320 0 lineto stroke
0.627 0.353 0.863 setrgbcolor
[6 4] 0 setdash newpath 0 50 moveto 640 50 lineto stroke
grestore
showpage
%%EOF
