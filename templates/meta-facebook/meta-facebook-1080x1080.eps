%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 1080 1080
%%HiResBoundingBox: 0 0 1080 1080
%%Title: Meta (Facebook) 1080x1080
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Red Green Blue
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
1 setlinewidth
% layer: Safe Zone
0.118 0.667 0.314 setrgbcolor
[] 0 setdash 54 54 972 972 rectstroke
% layer: Trim
0.000 0.588 0.863 setrgbcolor
[] 0 setdash 0 0 1080 1080 rectstroke
% layer: Guides
0.627 0.353 0.863 setrgbcolor
[6 4] 0 setdash newpath 540 1080 moveto 540 0 lineto stroke
0.627 0.353 0.863 setrgbcolor
[6 4] 0 setdash newpath 0 540 moveto 1080 540 lineto stroke
grestore
showpage
%%EOF
