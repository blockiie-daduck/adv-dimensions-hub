%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 513 351
%%HiResBoundingBox: 0 0 513 351
%%Title: Trade Publication 1/2 Page Horizontal (6.875x4.625 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 45 45 423 261 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 9 9 495 333 rectstroke
% layer: Bleed
0.000 1.000 1.000 0.000 setcmykcolor
[] 0 setdash 0 0 513 351 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 256.5 342 moveto 256.5 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 9 175.5 moveto 504 175.5 lineto stroke
grestore
showpage
