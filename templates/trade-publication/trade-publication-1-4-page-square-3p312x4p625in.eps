%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 257 351
%%HiResBoundingBox: 0 0 256.5 351
%%Title: Trade Publication 1/4 Page Square (3.3125x4.625 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 45 45 166.5 261 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 9 9 238.5 333 rectstroke
% layer: Bleed
0.000 1.000 1.000 0.000 setcmykcolor
[] 0 setdash 0 0 256.5 351 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 128.25 342 moveto 128.25 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 9 175.5 moveto 247.5 175.5 lineto stroke
grestore
showpage
