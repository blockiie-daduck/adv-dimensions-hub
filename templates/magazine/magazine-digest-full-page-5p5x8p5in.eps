%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 414 630
%%HiResBoundingBox: 0 0 414 630
%%Title: Magazine Digest Full Page (5.5x8.5 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 27 27 360 576 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 9 9 396 612 rectstroke
% layer: Bleed
0.000 1.000 1.000 0.000 setcmykcolor
[] 0 setdash 0 0 414 630 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 207 621 moveto 207 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 9 315 moveto 405 315 lineto stroke
grestore
showpage
%%EOF
