%%Title: Magazine Two-Page Spread (17x11 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 27 27 1188 756 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 9 9 1224 792 rectstroke
% layer: Bleed
0.000 1.000 1.000 0.000 setcmykcolor
[] 0 setdash 0 0 1242 810 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 621 801 moveto 621 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 9 405 moveto 1233 405 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 585 801 moveto 585 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 657 801 moveto 657 9 lineto stroke
grestore
showpage
