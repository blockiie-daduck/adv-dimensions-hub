%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 261 360
%%HiResBoundingBox: 0 0 261 360
%%Title: Magazine Quarter Page (3.375x4.75 in)
%%Creator: Ad Dimensions Toolkit
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%% Guides only. EPS has no layers: delete the guide strokes or place your artwork beneath them.
gsave
0.5 setlinewidth
% layer: Safe Zone
0.800 0.000 1.000 0.000 setcmykcolor
[] 0 setdash 27 27 207 306 rectstroke
% layer: Trim
1.000 0.200 0.000 0.000 setcmykcolor
[] 0 setdash 9 9 243 342 rectstroke
% layer: Bleed
0.000 1.000 1.000 0.000 setcmykcolor
[] 0 setdash 0 0 261 360 rectstroke
% layer: Guides
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 130.5 351 moveto 130.5 9 lineto stroke
0.400 0.700 0.000 0.000 setcmykcolor
[3 2] 0 setdash newpath 9 180 moveto 252 180 lineto stroke
grestore
showpage
%%EOF
